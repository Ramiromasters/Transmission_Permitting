    const searchInput = document.getElementById("searchInput");
    let currentMode = "ug";

    function renderMode(mode) {
      currentMode = mode;
      const data = checklistData[mode];
      modeTitle.textContent = data.title;
      modeDescription.textContent = data.description;
      modeTags.innerHTML = data.tags.map(tag => `<span class="tag">${tag}</span>`).join("");
      sectionsContainer.innerHTML = sectionOrder.map(key => renderSection(key, data.sections[key])).join("");
      filterItems(searchInput.value);
    }

    function renderSection(key, section) {
      const items = section.items.map(item => `
        <li data-search="${escapeHtml(item.toLowerCase())}">
          <input type="checkbox" />
          <span>${item}</span>
        </li>
      `).join("");

      const note = section.note ? `<div class="note-box"><strong>Permit note:</strong> ${section.note}</div>` : "";
      const warning = section.warning ? `<div class="warning-box"><strong>Watch item:</strong> ${section.warning}</div>` : "";

      return `
        <details class="section" id="${key}" open>
          <summary>${section.title}</summary>
          <div class="section-body">
            <ul class="checklist">${items}</ul>
            ${note}
            ${warning}
          </div>
        </details>
      `;
    }

    function escapeHtml(value) {
      return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function filterItems(query) {
      const q = query.trim().toLowerCase();
      document.querySelectorAll(".checklist li").forEach(li => {
        const match = !q || li.textContent.toLowerCase().includes(q);
        li.classList.toggle("hidden", !match);
      });

      document.querySelectorAll(".section").forEach(section => {
        const visibleItems = section.querySelectorAll(".checklist li:not(.hidden)").length;
        section.classList.toggle("hidden", q && visibleItems === 0 && !section.textContent.toLowerCase().includes(q));
      });
    }

    document.querySelectorAll(".mode-card").forEach(card => {
      card.addEventListener("click", () => {
        document.querySelectorAll(".mode-card").forEach(c => c.classList.remove("active"));
        card.classList.add("active");
        renderMode(card.dataset.mode);
      });
    });

    document.querySelectorAll(".nav-button").forEach(button => {
      button.addEventListener("click", () => {
        document.querySelectorAll(".nav-button").forEach(b => b.classList.remove("active"));
        button.classList.add("active");
        const target = document.getElementById(button.dataset.jump);
        if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    searchInput.addEventListener("input", e => filterItems(e.target.value));

    function setDateLine() {
      const dateLine = document.getElementById("dateLine");
      const now = new Date();
      const options = { weekday: "long", month: "long", day: "numeric", hour: "2-digit", minute: "2-digit" };
      dateLine.textContent = now.toLocaleString(undefined, options).replace(",", " •");
    }

    setDateLine();
    renderMode("ug");
  </script>
</body>
</html>
