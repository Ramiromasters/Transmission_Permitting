<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Transmission Permit Checklist Portal</title>
  <style>
    :root {
      --teal: #77c5b8;
      --teal-dark: #2e8178;
      --panel: rgba(244, 255, 250, 0.92);
      --panel-solid: #f4fffa;
      --ink: #20313f;
      --muted: #637383;
      --orange: #e88700;
      --danger: #b92f2f;
      --shadow: 0 18px 45px rgba(0, 0, 0, 0.22);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--ink);
      min-height: 100vh;
      background:
        linear-gradient(rgba(18, 55, 72, 0.25), rgba(11, 54, 61, 0.42)),
        url("https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=2200&q=80") center/cover fixed;
    }

    .topbar {
      height: 34px;
      background: rgba(119, 197, 184, 0.88);
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 0 24px;
      font-weight: 700;
      color: #174d49;
      gap: 10px;
      letter-spacing: 0.2px;
    }

    .hamburger {
      font-size: 24px;
      line-height: 1;
    }

    .hero {
      max-width: 1320px;
      margin: 0 auto;
      padding: 24px 24px 70px;
      text-align: center;
    }

    h1 {
      margin: 10px 0 12px;
      color: white;
      font-size: clamp(42px, 6vw, 78px);
      line-height: 0.95;
      letter-spacing: 1px;
      text-shadow: 0 6px 22px rgba(0, 0, 0, 0.4);
    }

    .subtitle {
      color: rgba(255, 255, 255, 0.92);
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 1px;
      text-shadow: 0 4px 12px rgba(0, 0, 0, 0.35);
    }

    .search-wrap {
      max-width: 650px;
      margin: 44px auto 28px;
      position: relative;
    }

    .search-wrap input {
      width: 100%;
      height: 72px;
      border: none;
      outline: none;
      border-radius: 999px;
      padding: 0 32px;
      font-size: 21px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.94);
      box-shadow: var(--shadow);
    }

    .search-wrap input::placeholder {
      color: #a1acb7;
      font-weight: 600;
    }

    .mode-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(240px, 1fr));
      gap: 28px;
      margin: 38px auto 24px;
      max-width: 980px;
    }

    .mode-card {
      border: none;
      cursor: pointer;
      border-radius: var(--radius);
      background: var(--panel);
      padding: 24px;
      box-shadow: var(--shadow);
      text-align: left;
      transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
      min-height: 150px;
    }

    .mode-card:hover,
    .mode-card.active {
      transform: translateY(-4px);
      background: #ffffff;
      box-shadow: 0 24px 58px rgba(0, 0, 0, 0.28);
    }

    .mode-icon {
      font-size: 32px;
      color: var(--orange);
      margin-bottom: 10px;
    }

    .mode-title {
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .mode-copy {
      color: var(--muted);
      font-size: 15px;
      line-height: 1.35;
    }

    .portal-layout {
      display: grid;
      grid-template-columns: 330px 1fr;
      gap: 24px;
      margin-top: 30px;
      text-align: left;
    }

    .sidebar,
    .content-panel {
      background: rgba(250, 255, 253, 0.94);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      backdrop-filter: blur(8px);
    }

    .sidebar {
      padding: 16px;
      align-self: start;
      position: sticky;
      top: 18px;
    }

    .sidebar-title {
      font-weight: 900;
      font-size: 18px;
      padding: 12px 12px 14px;
      border-bottom: 1px solid rgba(32, 49, 63, 0.12);
    }

    .nav-button {
      width: 100%;
      border: none;
      border-radius: 13px;
      background: transparent;
      color: var(--ink);
      padding: 14px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font-weight: 800;
      font-size: 15px;
      text-align: left;
      cursor: pointer;
      margin-top: 7px;
    }

    .nav-button:hover,
    .nav-button.active {
      background: #e8f6f1;
      color: #0f5c56;
    }

    .content-panel {
      padding: 24px;
      min-height: 520px;
    }

    .content-header {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
      border-bottom: 1px solid rgba(32, 49, 63, 0.12);
      padding-bottom: 18px;
      margin-bottom: 18px;
    }

    .content-header h2 {
      margin: 0 0 8px;
      font-size: 30px;
    }

    .content-header p {
      margin: 0;
      color: var(--muted);
      line-height: 1.45;
      max-width: 720px;
    }

    .print-button {
      border: none;
      border-radius: 999px;
      padding: 12px 18px;
      background: var(--teal-dark);
      color: white;
      font-weight: 800;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: 0 10px 22px rgba(46, 129, 120, 0.28);
    }

    .section {
      margin: 20px 0;
      border: 1px solid rgba(32, 49, 63, 0.12);
      border-radius: 16px;
      overflow: hidden;
      background: white;
    }

    .section summary {
      cursor: pointer;
      padding: 18px 20px;
      font-size: 18px;
      font-weight: 900;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .section summary::-webkit-details-marker {
      display: none;
    }

    .section summary::after {
      content: "⌄";
      color: var(--teal-dark);
      font-size: 24px;
      transition: transform 0.18s ease;
    }

    .section[open] summary::after {
      transform: rotate(180deg);
    }

    .section-body {
      padding: 0 20px 20px;
    }

    .checklist {
      display: grid;
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .checklist li {
      display: grid;
      grid-template-columns: 28px 1fr;
      gap: 10px;
      align-items: start;
      padding: 11px 12px;
      border-radius: 12px;
      background: #f6faf8;
      line-height: 1.35;
    }

    .checklist input {
      width: 18px;
      height: 18px;
      margin-top: 1px;
      accent-color: var(--teal-dark);
    }

    .tag-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 12px;
    }

    .tag {
      background: #e7f6f2;
      color: #236d66;
      font-weight: 800;
      border-radius: 999px;
      padding: 7px 11px;
      font-size: 13px;
    }

    .note-box {
      border-left: 5px solid var(--orange);
      background: #fff7e8;
      padding: 16px;
      border-radius: 12px;
      line-height: 1.5;
      margin-top: 16px;
    }

    .warning-box {
      border-left: 5px solid var(--danger);
      background: #fff0f0;
      padding: 16px;
      border-radius: 12px;
      line-height: 1.5;
      margin-top: 16px;
    }

    .footer {
      margin: 40px 0 0;
      color: rgba(255, 255, 255, 0.83);
      font-weight: 800;
      text-align: center;
      text-shadow: 0 3px 8px rgba(0, 0, 0, 0.35);
    }

    .hidden {
      display: none;
    }

    @media (max-width: 980px) {
      .mode-grid,
      .portal-layout {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: static;
      }
    }

    @media print {
      body {
        background: white;
      }

      .topbar,
      .search-wrap,
      .mode-grid,
      .sidebar,
      .print-button,
      .footer {
        display: none;
      }

      .hero {
        padding: 0;
      }

      h1,
      .subtitle {
        color: black;
        text-shadow: none;
      }

      .portal-layout {
        display: block;
      }

      .content-panel {
        box-shadow: none;
      }
    }
  </style>
</head>
